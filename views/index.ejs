 <!DOCTYPE html>
 <html lang="en">

 <head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Usernames</title>
 </head>

 <body>
   <h1>Available Usernames</h1>

   <ul>
     <% usernames.forEach((username) => { %>
     <li><%= username %></li>
     <% }) %>
   </ul>

   <a href="/new">Add a new username</a>
 </body>

 </html>